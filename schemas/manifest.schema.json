{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "BOOK",
        "ALBUM"
      ]
    },
    "work": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "assets": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,60}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "externalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "kind": {
            "type": "string",
            "enum": [
              "IMAGE",
              "AUDIO"
            ]
          },
          "mimeType": {
            "type": "string",
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp",
              "audio/mpeg",
              "audio/wav",
              "audio/mp4",
              "audio/ogg"
            ]
          }
        },
        "required": [
          "path",
          "kind",
          "mimeType"
        ],
        "additionalProperties": false
      }
    },
    "bindings": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(coverAssetId|pages\\.\\d+\\.(imageAssetId|audioAssetId))$"
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "work"
  ],
  "additionalProperties": false
}
