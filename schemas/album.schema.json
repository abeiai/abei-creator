{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "externalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "expectedVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "coverAssetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "items": {
      "minItems": 1,
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "bookId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "bookId",
          "expectedVersion",
          "displayName"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "externalId",
    "expectedVersion",
    "title",
    "summary",
    "coverAssetId",
    "items"
  ],
  "additionalProperties": false
}
